# -----------------------------------------------------------------------------
# Redirige todas las peticiones a la carpeta public/ (raíz web correcta de Laravel).
#
# Úsalo SOLO si el Document Root del dominio apunta a la raíz del proyecto en
# lugar de a public/. Si ya configuraste el Document Root en .../public, este
# archivo no se lee y no afecta en nada.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Defensa en profundidad: nunca servir el .env desde la raíz.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
