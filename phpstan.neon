includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    level: 5

    # La certeza de tipos derivada de PHPDoc (p. ej. desde el esquema) no siempre
    # refleja el runtime; no la tratamos como garantia.
    treatPhpDocTypesAsCertain: false

    parallel:
        maximumNumberOfProcesses: 4

    ignoreErrors:
        # Atributos dinamicos de Eloquent.
        - '#Access to an undefined property#'
